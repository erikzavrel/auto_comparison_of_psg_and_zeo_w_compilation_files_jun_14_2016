  row_total_stage_by_stage_psg_rem = contingency_table_stage_by_stage_zeo_wake_psg_rem_count + contingency_table_stage_by_stage_zeo_rem_psg_rem_count + contingency_table_stage_by_stage_zeo_light_psg_rem_count + contingency_table_stage_by_stage_zeo_deep_psg_rem_count;
  row_total_stage_by_stage_psg_light = contingency_table_stage_by_stage_zeo_wake_psg_light_count + contingency_table_stage_by_stage_zeo_rem_psg_light_count + contingency_table_stage_by_stage_zeo_light_psg_light_count + contingency_table_stage_by_stage_zeo_deep_psg_light_count;
