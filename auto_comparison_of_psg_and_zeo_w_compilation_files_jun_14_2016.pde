// *****************************************************************************************************************************************************************************************  
 
void mouseReleased() {
     
    if ((mouseX >= screen.width - 50) && (mouseX < screen.width) && (mouseY >= screen.height - 50) && (mouseY <= screen.height)) { // if cursor is over "EXIT" icon, exit program
      
      if (file_open_program_flag == true) {
        output.flush();
        output.close();
      } // close files before exiting program to prevent corruption of data
      
      exit(); // exit program  
      
    } // end if
  
    else if ((mouseX >= screen.width - 100) && (mouseX < screen.width - 50) && (mouseY >= screen.height - 50) && (mouseY <= screen.height)) { // if cursor is over "MAIN" icon, return to main 
      reset_program_flags_function(); // reset all program flags in status registry to default state
      program_state = prompt_user_to_continue_or_exit_program_state; // update program state to move on
    } // end else if
  
} // end of mouseReleased function
  
