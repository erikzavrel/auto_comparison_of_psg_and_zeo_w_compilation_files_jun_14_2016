  interpolated_psg_stage_data_timestamp_minute_array = new int [psg_stage_data_interpolated_array_size]; // create array of correct size (complete file)
  interpolated_psg_stage_data_timestamp_second_array = new int [psg_stage_data_interpolated_array_size]; // create array of correct size (complete file)

  for (array_pointer_3 = 0; array_pointer_3 < psg_sleep_stage_data_array_header_removed_size - 1; array_pointer_3 = array_pointer_3 + 1) {
  
    psg_epoch_number_start = psg_stage_data_epoch_number_array[array_pointer_3]; // starting epoch is nth item in array
    psg_epoch_number_end = psg_stage_data_epoch_number_array[array_pointer_3 + 1]; // ending epoch is nth + 1 item in array
    
    // must use < array_size - 1 as last item is array size - 1 so last n element for which there is an n + 1 element in array is array size - 2 or < array_size - 1
  
    psg_timestamp_string = psg_stage_data_timestamp_array[array_pointer_3]; // read from array
    psg_stage_data_stage_description = psg_stage_data_stage_description_array[array_pointer_3]; // read from array
    
    second_incrementer = 0; // reset to 0
    
    psg_stage_data_stage_description_processed_array[0] = ' ';
    psg_stage_data_stage_description_processed_array[1] = ' ';    
    psg_stage_data_stage_description_processed_array[2] = ' ';
    psg_stage_data_stage_description_processed_array[3] = ' ';
    psg_stage_data_stage_description_processed_array[4] = ' ';
    psg_stage_data_stage_description_processed_array[5] = ' ';
    psg_stage_data_stage_description_processed_array[6] = ' ';
    psg_stage_data_stage_description_processed_array[7] = ' ';
  
    // clear array
   
    for (array_pointer_4 = psg_epoch_number_start - 1; array_pointer_4 < psg_epoch_number_end - 1; array_pointer_4 = array_pointer_4 + 1) {
   
      interpolation_function_2(); // call function
      
      // must use -1 for start and -1 for end points as want to begin writing to 0th element in array
  
    } // end for ... next loop
  
  } // end for ... next loop
  
  psg_stage_data_stage_description = psg_stage_data_stage_description_array[array_pointer_3]; 
   
  interpolation_function_2(); // call function for final epoch as for ... next loop only completed interpolation up to but not including last epoch as for final nth element there is no n + 1 element (array out of range error)
      
  output.flush();
  output.close();
  
  file_open_program_flag = false; // reset program flag
  
  return;
  
} // end of interpolation_function_1
    
