  output.println(); // blank line
  output.println("REM Block Number" + "," + "Block Duration (min)");
  output.println(); // insert header, last item written to file must be printed using "println" to move to next line
  
  output.flush();
  output.close();

  file_open_program_flag = false; // reset program flag
  
  psg_epoch_number_array_element_number = psg_epoch_number_start_ref_array_element_number; // initialize
  
  for (array_pointer_9 = zeo_data_range_start_element_number; array_pointer_9 <= zeo_data_range_end_element_number; array_pointer_9 = array_pointer_9 + 1) {
  
    read_from_array_for_comparison_function(); // call function
      
    if (psg_recording_start_time_set_program_flag == false) {
      
      psg_recording_time_start_seconds = calculate_timestamp_seconds(psg_timestamp_hour, psg_timestamp_minute, psg_timestamp_second); // call function and pass parameters
            
      psg_recording_start_time_set_program_flag = true; // set program flag
      
    } // end if
    
    psg_recording_time_end_seconds = calculate_timestamp_seconds(psg_timestamp_hour, psg_timestamp_minute, psg_timestamp_second); // call function and pass parameters
    
    // no need to set program flag as will be overwritten each time and will end up holding last (and desired) value corresponding to recording time end

    if (psg_stage_data_stage_description_processed.equals(psg_unknown_sleep_stage_description) == true) {
      psg_total_seconds_unknown_sleep_stage = psg_total_seconds_unknown_sleep_stage + 30; // sleep stage determination is made every 30 seconds
    } // end else if
    
    if (psg_stage_data_stage_description_processed.equals(psg_no_stage_sleep_stage_description) == true) {
      psg_total_seconds_no_stage_sleep_stage = psg_total_seconds_no_stage_sleep_stage + 30; // sleep stage determination is made every 30 seconds
    } // end else if
  
    else if (psg_stage_data_stage_description_processed.equals(psg_wake_sleep_stage_description_final) == true) { // compares two strings to see if they are the same: this method is necessary because it's not possible to compare strings using the equality operator (==)
      
      psg_total_seconds_wake_sleep_stage = psg_total_seconds_wake_sleep_stage + 30; // sleep stage determination is made every 30 seconds
      
      if (psg_sleep_onset_program_flag == true) { // only execute if sleep onset has occurred: prevents time to fall asleep from being recorded as an awakening
        psg_awakening_duration_seconds = psg_awakening_duration_seconds + 30; // sleep stage determination is made every 30 seconds
      } // end if
      
    } // end else if
  
    else if (psg_stage_data_stage_description_processed.equals(psg_rem_sleep_stage_description_final) == true) { // compares two strings to see if they are the same: this method is necessary because it's not possible to compare strings using the equality operator (==)
      
      psg_total_seconds_rem_sleep_stage = psg_total_seconds_rem_sleep_stage + 30; // sleep stage determination is made every 30 seconds
      psg_total_sleep_time_seconds = psg_total_sleep_time_seconds + 30; // sleep stage determination is made every 30 seconds (asleep = L, D, or REM)
      
      if (psg_rem_onset_program_flag == false) { // if this is the first time REM has occurred
        
        psg_rem_onset_time_seconds = calculate_timestamp_seconds(psg_timestamp_hour, psg_timestamp_minute, psg_timestamp_second); // call function and pass parameters
        
        psg_rem_onset_date = zeo_timestamp_date;
      
        psg_rem_onset_program_flag = true; // set the flag so that this code block does not execute again
        
      } // end if
      
      psg_rem_epoch_duration_seconds = psg_rem_epoch_duration_seconds + 30; // sleep stage determination is made every 30 seconds
      
    } // end else if
  
    else if ((psg_stage_data_stage_description_processed.equals(psg_N1_sleep_stage_description_final) == true) || (psg_stage_data_stage_description_processed.equals(psg_N2_sleep_stage_description_final) == true)) { // compares two strings to see if they are the same: this method is necessary because it's not possible to compare strings using the equality operator (==)
      psg_total_seconds_light_sleep_stage = psg_total_seconds_light_sleep_stage + 30; // sleep stage determination is made every 30 seconds
      psg_total_sleep_time_seconds = psg_total_sleep_time_seconds + 30; // sleep stage determination is made every 30 seconds (asleep = L, D, or REM)
    } // end else if

    else if (psg_stage_data_stage_description_processed.equals(psg_N3_sleep_stage_description_final) == true) { // compares two strings to see if they are the same: this method is necessary because it's not possible to compare strings using the equality operator (==)
      psg_total_seconds_deep_sleep_stage = psg_total_seconds_deep_sleep_stage + 30; // sleep stage determination is made every 30 seconds
      psg_total_sleep_time_seconds = psg_total_sleep_time_seconds + 30; // sleep stage determination is made every 30 seconds (asleep = L, D, or REM)  
    } // end else if
    
    if (psg_sleep_onset_program_flag == true) { // only execute if sleep onset has occurred: prevents time to fall asleep from being recorded as an awakening
        
      if ((psg_sleep_stage_description_old.equals(psg_wake_sleep_stage_description_final) == true) && (psg_stage_data_stage_description_processed.equals(psg_wake_sleep_stage_description_final) == false)) { // if last stage was awake and current stage is not awake, then awakening has ended (prevents final awakening from sleep from being counted)
      
        psg_awakening_file_array = loadStrings(psg_awakening_file_name); // read contents of file to array 
      
        psg_awakening_file_array_size = psg_awakening_file_array.length; // get the raw size of the file including header
        psg_awakening_file_array_header_removed_size = psg_awakening_file_array_size - file_header_offset; // subtract header offset to get processed size of file array
        psg_awakening_file_array_header_removed = new String [psg_awakening_file_array_header_removed_size]; // create - subset of file array with header removed (only data)
        arrayCopy(psg_awakening_file_array, file_header_offset, psg_awakening_file_array_header_removed, 0, psg_awakening_file_array_header_removed_size); // assign - copy only data items to new array (omit header)      

        output = createWriter(psg_awakening_file_name);
        file_open_program_flag = true; // set program flag
   
        output.println("PSG Awakening File");
        output.println(); // blank line
        output.println("Subject ID Number: " + "," + id_number_of_psg_sleep_stage_file_name);
        output.println(); // blank line
        output.println("Awakening Number" + "," + "Awakening Duration (min)");
        output.println(); // insert header, last item written to file must be printed using "println" to move to next line

        for (array_pointer_10 = 0; array_pointer_10 < psg_awakening_file_array_header_removed_size; array_pointer_10 = array_pointer_10 + 1) {
        
          output.println(psg_awakening_file_array_header_removed[array_pointer_10]); // cycle through array and write elements back to file
        
        } // end for ... next loop
        
        psg_number_of_awakenings = psg_number_of_awakenings + 1; // another awakening has occurred (distinct and not contiguous events)

        psg_awakening_duration_minutes = psg_awakening_duration_seconds / number_of_seconds_in_a_minute; // covert from seconds to minutes
  
        output.println(psg_number_of_awakenings + "," + psg_awakening_duration_minutes); // append new value to end of file
      
        output.flush();
        output.close();
      
        file_open_program_flag = false; // reset program flag      
        
        psg_wakefulness_after_sleep_onset_minutes = psg_wakefulness_after_sleep_onset_minutes + psg_awakening_duration_minutes; // increment (time between sleep onset and final awakening)
     
        psg_awakening_duration_seconds = 0; // awakening has ended, log it and reset the awakening duration counter to 0
    
      } // end if
        
    } // end if

    if ((psg_sleep_stage_description_old.equals(psg_rem_sleep_stage_description_final) == true) && (psg_stage_data_stage_description_processed.equals(psg_rem_sleep_stage_description_final) == false)) { // if last stage was rem and current stage is not rem, then rem epoch has ended
    
      psg_rem_epoch_file_array = loadStrings(psg_rem_file_name); // read contents of file to array  

      psg_rem_epoch_file_array_size = psg_rem_epoch_file_array.length; // get the raw size of the file including header
      psg_rem_epoch_file_array_header_removed_size = psg_rem_epoch_file_array_size - file_header_offset; // subtract header offset to get processed size of file array
      psg_rem_epoch_file_array_header_removed = new String [psg_rem_epoch_file_array_header_removed_size]; // create - subset of file array with header removed (only data)
      arrayCopy(psg_rem_epoch_file_array, file_header_offset, psg_rem_epoch_file_array_header_removed, 0, psg_rem_epoch_file_array_header_removed_size); // assign - copy only data items to new array (omit header)      

      output = createWriter(psg_rem_file_name);
      file_open_program_flag = true; // set program flag
   
      output.println("PSG REM File");
      output.println(); // blank line
      output.println("Subject ID Number: " + "," + id_number_of_psg_sleep_stage_file_name);
      output.println(); // blank line
      output.println("REM Block Number" + "," + "Block Duration (min)"); 
      output.println(); // insert header, last item written to file must be printed using "println" to move to next line

      for (array_pointer_10 = 0; array_pointer_10 < psg_rem_epoch_file_array_header_removed_size; array_pointer_10 = array_pointer_10 + 1) {
        
        output.println(psg_rem_epoch_file_array_header_removed[array_pointer_10]); // cycle through array and write elements back to file
        
      } // end for ... next loop
      
      psg_number_of_rem_blocks = psg_number_of_rem_blocks + 1; // another instance of rem or epoch has occurred (distinct and not contiguous events)
      psg_rem_epoch_duration_minutes = psg_rem_epoch_duration_seconds / number_of_seconds_in_a_minute; // covert from seconds to minutes
            
      output.println(psg_number_of_rem_blocks + "," + psg_rem_epoch_duration_minutes); // append new value to end of file
      
      output.flush();
      output.close();
      
      file_open_program_flag = false; // reset program flag 
 
      psg_rem_epoch_duration_seconds = 0; // rem epoch has ended, log it and reset the epoch duration counter to 0     
    
    } // end if
    
    if ((psg_stage_data_stage_description_processed.equals(psg_rem_sleep_stage_description_final) == true) || (psg_stage_data_stage_description_processed.equals(psg_N1_sleep_stage_description_final) == true) || (psg_stage_data_stage_description_processed.equals(psg_N2_sleep_stage_description_final) == true) || (psg_stage_data_stage_description_processed.equals(psg_N3_sleep_stage_description_final) == true)) { // compares two strings to see if they are the same: this method is necessary because it's not possible to compare strings using the equality operator (==)
      
      if (psg_sleep_onset_program_flag == false) { // if this is the first time sleep onset event has occurred (the first epoch of sleep no matter what stage) 

        psg_sleep_onset_time_seconds = calculate_timestamp_seconds(psg_timestamp_hour, psg_timestamp_minute, psg_timestamp_second); // call function and pass parameters
   
        psg_sleep_onset_date = zeo_timestamp_date;
        
        psg_sleep_onset_program_flag = true; // set the flag so that this code block does not execute again
        
      } // end if
      
      psg_seconds_of_continuous_sleep = psg_seconds_of_continuous_sleep + 30; // increment counter
      
    } // end if
    
    else {
      
      psg_seconds_of_continuous_sleep = 0; // reset counter
      
    } // end else
    
    psg_minutes_of_continuous_sleep = psg_seconds_of_continuous_sleep / number_of_seconds_in_a_minute; // covert from seconds to minutes

    if (psg_persistent_sleep_onset_program_flag == false) {
    
      if (psg_minutes_of_continuous_sleep >= 10) { // persistent sleep is defined as 10 minutes of continuous sleep

        psg_persistent_sleep_onset_time_seconds = calculate_timestamp_seconds(psg_timestamp_hour, psg_timestamp_minute, psg_timestamp_second); // call function and pass parameters
   
        psg_persistent_sleep_onset_date = zeo_timestamp_date;
        
        psg_persistent_sleep_onset_program_flag = true; // set the flag so that this code block does not execute again
        
      } // end if  
    
    } // end if

    if (psg_sleep_onset_program_flag == true) {
      
      if ((psg_stage_data_stage_description_processed.equals(psg_unknown_sleep_stage_description) == false) && (psg_stage_data_stage_description_processed.equals(psg_no_stage_sleep_stage_description) == false)) {
             
        if (psg_sleep_stage_description_stage_by_stage_for_spss.equals(psg_sleep_stage_description_stage_by_stage_for_spss_old) == true) { // use SPSS descriptor so N1 / N2 transitions do not count as a stage change
          
          psg_duration_without_stage_transition_seconds = psg_duration_without_stage_transition_seconds + 30; // increment
        
        } // end if
      
        else {
                
          psg_total_duration_without_stage_transition_seconds = psg_total_duration_without_stage_transition_seconds + psg_duration_without_stage_transition_seconds; // increment
         
          if (psg_duration_without_stage_transition_seconds != 0) { // to prevent from counting transition of wake to sleep
            psg_blocks_without_stage_transition_counter = psg_blocks_without_stage_transition_counter + 1; // increment
          } // end if
          
          psg_duration_without_stage_transition_seconds = 30;
        
        } // end else
       
      } // end if
          
    } // end if    
    
    psg_sleep_stage_description_old = psg_stage_data_stage_description_processed; // update old sleep stage 
    psg_sleep_stage_description_stage_by_stage_for_spss_old = psg_sleep_stage_description_stage_by_stage_for_spss; // update old sleep stage
 
    psg_epoch_number_array_element_number = psg_epoch_number_array_element_number + 1; // increment   
  
  } // end of for ... next
  
  if ((psg_sleep_stage_description_old.equals(psg_wake_sleep_stage_description_final) == false) && (psg_sleep_stage_description_old.equals(psg_unknown_sleep_stage_description) == false) && (psg_sleep_stage_description_old.equals(psg_no_stage_sleep_stage_description) == false)) {
       
    psg_total_duration_without_stage_transition_seconds = psg_total_duration_without_stage_transition_seconds + psg_duration_without_stage_transition_seconds;
    psg_blocks_without_stage_transition_counter = psg_blocks_without_stage_transition_counter + 1;
    
  } // only count last continuous block if not unknown, missing, or awake (want measure of sleep fragmentation)

  psg_average_duration_without_stage_transition_seconds = psg_total_duration_without_stage_transition_seconds / float(psg_blocks_without_stage_transition_counter);
  psg_average_duration_without_stage_transition_minutes = psg_average_duration_without_stage_transition_seconds / number_of_seconds_in_a_minute; // measure of sleep fragmentation  
  
  if (psg_rem_epoch_duration_seconds != 0) { // check to see if ending comparison in middle of a REM epoch
       
    psg_rem_epoch_file_array = loadStrings(psg_rem_file_name); // read contents of file to array  

    psg_rem_epoch_file_array_size = psg_rem_epoch_file_array.length; // get the raw size of the file including header
    psg_rem_epoch_file_array_header_removed_size = psg_rem_epoch_file_array_size - file_header_offset; // subtract header offset to get processed size of file array
    psg_rem_epoch_file_array_header_removed = new String [psg_rem_epoch_file_array_header_removed_size]; // create - subset of file array with header removed (only data)
    arrayCopy(psg_rem_epoch_file_array, file_header_offset, psg_rem_epoch_file_array_header_removed, 0, psg_rem_epoch_file_array_header_removed_size); // assign - copy only data items to new array (omit header)      

    output = createWriter(psg_rem_file_name);
    file_open_program_flag = true; // set program flag
   
    output.println("PSG REM File");
    output.println(); // blank line
    output.println("Subject ID Number: " + "," + id_number_of_psg_sleep_stage_file_name);
    output.println(); // blank line
    output.println("REM Block Number" + "," + "Block Duration (min)"); 
    output.println(); // insert header, last item written to file must be printed using "println" to move to next line

    for (array_pointer_10 = 0; array_pointer_10 < psg_rem_epoch_file_array_header_removed_size; array_pointer_10 = array_pointer_10 + 1) {
        
      output.println(psg_rem_epoch_file_array_header_removed[array_pointer_10]); // cycle through array and write elements back to file
        
    } // end for ... next loop
      
    psg_number_of_rem_blocks = psg_number_of_rem_blocks + 1; // another instance of rem or epoch has occurred (distinct and not contiguous events)
    psg_rem_epoch_duration_minutes = psg_rem_epoch_duration_seconds / number_of_seconds_in_a_minute; // covert from seconds to minutes
            
    output.println(psg_number_of_rem_blocks + "," + psg_rem_epoch_duration_minutes); // append new value to end of file
      
    output.flush();
    output.close();
      
    file_open_program_flag = false; // reset program flag 
 
    psg_rem_epoch_duration_seconds = 0; // rem epoch has ended, log it and reset the epoch duration counter to 0     
    
  } // end if   
    
  if (psg_recording_time_end_seconds >= psg_recording_time_start_seconds) {  
    psg_total_recording_time_seconds = psg_recording_time_end_seconds - psg_recording_time_start_seconds + 30; // total observation time if study starts and ends on same date
  } // end if
  
  else {
    psg_total_recording_time_seconds = number_of_seconds_in_a_day - psg_recording_time_start_seconds + psg_recording_time_end_seconds + 30; // total observation time if study starts and ends on different date
  } // end else
    
  if (psg_sleep_onset_time_seconds >= psg_recording_time_start_seconds) {
    psg_sleep_onset_latency_seconds = psg_sleep_onset_time_seconds - psg_recording_time_start_seconds; // time from recording start to sleep onset if recording starts and sleep onset occurs on same date
  } // end if
  
  else {
    psg_sleep_onset_latency_seconds = number_of_seconds_in_a_day - psg_recording_time_start_seconds + psg_sleep_onset_time_seconds; // time from recording start to sleep onset if recording starts and sleep onset occurs on different date
  } // end else
  
  if (psg_persistent_sleep_onset_time_seconds >= psg_recording_time_start_seconds) {
    psg_latency_to_persistent_sleep_seconds = psg_persistent_sleep_onset_time_seconds - psg_recording_time_start_seconds + 30; // time from recording start to sleep onset if recording starts and onset of persistent sleep occurs on same date
  } // end if
  
  else {
    psg_latency_to_persistent_sleep_seconds = number_of_seconds_in_a_day - psg_recording_time_start_seconds + psg_persistent_sleep_onset_time_seconds + 30; // time from recording start to sleep onset if recording starts and onset of persistent sleep occurs on different date
  } // end else
  
  if (psg_rem_onset_time_seconds >= psg_sleep_onset_time_seconds) {
    psg_rem_onset_latency_seconds = psg_rem_onset_time_seconds - psg_sleep_onset_time_seconds; // time from sleep onset to REM onset if sleep onset and REM onset occur on same date
  } // end if
  
  else {
    psg_rem_onset_latency_seconds = number_of_seconds_in_a_day - psg_sleep_onset_time_seconds + psg_rem_onset_time_seconds; // time from sleep onset to REM onset if sleep onset and REM onset occur on different date
  } // end else
    
  psg_total_recording_time_minutes = psg_total_recording_time_seconds / number_of_seconds_in_a_minute; // convert from seconds to minutes
  
  if (psg_sleep_onset_program_flag == true) { // safety check: SOL exists only if sleep onset occurs
    psg_sleep_onset_latency_minutes = psg_sleep_onset_latency_seconds / number_of_seconds_in_a_minute; // convert from seconds to minutes
  } // end if
  
  else {
    psg_sleep_onset_latency_minutes = -1.0; // N/A
    psg_wakefulness_after_sleep_onset_minutes = -1.0; // N/A
  } // end else

  if (psg_persistent_sleep_onset_program_flag == true) { // safety check: LPS exists only if persistent sleep occurs
    psg_latency_to_persistent_sleep_minutes = psg_latency_to_persistent_sleep_seconds / number_of_seconds_in_a_minute; // convert from seconds to minutes  
  } // end if
  
  else { 
    psg_latency_to_persistent_sleep_minutes = -1.0; // N/A 
  } // end else
  
  if (psg_rem_onset_program_flag == true) { // safety check: REML exists only if REM sleep occurs
    psg_rem_onset_latency_minutes = psg_rem_onset_latency_seconds / number_of_seconds_in_a_minute; // convert from seconds to minutes
  } // end if
  
  else {
    psg_rem_onset_latency_minutes = -1.0; // N/A
  } // end else
      
  psg_total_minutes_unknown_sleep_stage = psg_total_seconds_unknown_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  psg_total_minutes_no_stage_sleep_stage = psg_total_seconds_no_stage_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  psg_total_minutes_wake_sleep_stage = psg_total_seconds_wake_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  psg_total_minutes_rem_sleep_stage = psg_total_seconds_rem_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  psg_total_minutes_light_sleep_stage = psg_total_seconds_light_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  psg_total_minutes_deep_sleep_stage = psg_total_seconds_deep_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
    
  psg_total_sleep_time_minutes = psg_total_sleep_time_seconds / number_of_seconds_in_a_minute; // convert from seconds to minutes

  if (psg_sleep_onset_program_flag == true) { // safety check: % exists only if sleep onset occurs
    psg_rem_sleep_stage_percentage = (psg_total_minutes_rem_sleep_stage / psg_total_sleep_time_minutes) * 100; // percentage of sleep that is REM
    psg_light_sleep_stage_percentage = (psg_total_minutes_light_sleep_stage / psg_total_sleep_time_minutes) * 100; // percentage of sleep that is L
    psg_deep_sleep_stage_percentage = (psg_total_minutes_deep_sleep_stage / psg_total_sleep_time_minutes) * 100; // percentage of sleep that is D  
  } // end if
  
  else {
    psg_rem_sleep_stage_percentage = -1.0; // N/A
    psg_light_sleep_stage_percentage = -1.0; // N/A
    psg_deep_sleep_stage_percentage = -1.0; // N/A
  } // end else

  psg_sleep_efficiency_percentage = (psg_total_sleep_time_minutes / psg_total_recording_time_minutes) * 100;

  output = createWriter(psg_night_summary_file_name_1);
  file_open_program_flag = true; // set program flag
   
  output.println("PSG Night Summary File 1");
  output.println(); // blank line
  output.println("Subject ID Number: " + "," + id_number_of_psg_sleep_stage_file_name);
  output.println(); // blank line
  output.println("Zeo / PSG" + "," + "TRT (min)" + "," + "TST (min)" + "," + "TWT (min)" + "," + "SE (%)" + "," + "Total Unknown (min)" + "," + "Total No Stage (min)" + "," + "Total L (min)" + "," + "Total D (min)" + "," + "Total REM (min)" + "," + "% L" + "," + "% D" + "," + "% REM" + "," + "SOL (min)" + "," + "LPS (min)" + "," + "WASO (min)" + "," + "Number of Awakenings" + "," + "REM Onset Latency (min)" + "," + "Number of REM Blocks" + "," + "Sleep Fragmentation (Average Number of Minutes Between Stage Transitions)" +"," + "Sleep Fragmentation (Size of Minimal PSG File)");
  output.println(); // blank line, last item written to file must be printed using "println" to move to next line
  
  output.println("PSG" + "," + psg_total_recording_time_minutes + "," + psg_total_sleep_time_minutes + "," + psg_total_minutes_wake_sleep_stage + "," + psg_sleep_efficiency_percentage + "," + psg_total_minutes_unknown_sleep_stage + "," + psg_total_minutes_no_stage_sleep_stage + "," + psg_total_minutes_light_sleep_stage + "," + psg_total_minutes_deep_sleep_stage + "," + psg_total_minutes_rem_sleep_stage + "," + psg_light_sleep_stage_percentage + "," + psg_deep_sleep_stage_percentage + "," + psg_rem_sleep_stage_percentage + "," + psg_sleep_onset_latency_minutes + "," + psg_latency_to_persistent_sleep_minutes + "," + psg_wakefulness_after_sleep_onset_minutes + "," + psg_number_of_awakenings + "," + psg_rem_onset_latency_minutes + "," + psg_number_of_rem_blocks + "," + psg_average_duration_without_stage_transition_minutes + "," + psg_sleep_stage_data_array_size);
    
  output.flush();
  output.close();
      
  file_open_program_flag = false; // reset program flag 

  output = createWriter(psg_night_summary_file_name_2);
  file_open_program_flag = true; // set program flag
   
  output.println("PSG Night Summary File 2");
  output.println(); // blank line
  output.println("Subject ID Number: " + "," + id_number_of_psg_sleep_stage_file_name);
  output.println(); // blank line
  output.println("Zeo / PSG: " + "," + "PSG");
  output.println(); // blank line
  output.println("TRT (min): " + "," + psg_total_recording_time_minutes);
  output.println("TST (min): " + "," + psg_total_sleep_time_minutes);
  output.println("TWT (min): " + "," + psg_total_minutes_wake_sleep_stage);
  output.println("SE (%): " + "," + psg_sleep_efficiency_percentage);
  output.println(); // blank line
  output.println("Total Unknown (min): " + "," + psg_total_minutes_unknown_sleep_stage);
  output.println("Total No Stage (min): " + "," + psg_total_minutes_no_stage_sleep_stage);
  output.println("Total L (min): " + "," + psg_total_minutes_light_sleep_stage);
  output.println("Total D (min): " + "," + psg_total_minutes_deep_sleep_stage);
  output.println("Total REM (min): " + "," + psg_total_minutes_rem_sleep_stage);
  output.println(); // blank line
  output.println("% L: " + "," + psg_light_sleep_stage_percentage);
  output.println("% D: " + "," + psg_deep_sleep_stage_percentage);
  output.println("% REM: " + "," + psg_rem_sleep_stage_percentage);
  output.println(); // blank line
  output.println("SOL (min): " + "," + psg_sleep_onset_latency_minutes);
  output.println("LPS (min): " + "," + psg_latency_to_persistent_sleep_minutes);
  output.println("WASO (min): " + "," + psg_wakefulness_after_sleep_onset_minutes);
  output.println("Number of Awakenings: " + "," + psg_number_of_awakenings);
  output.println(); // blank line
  output.println("REM Onset Latency (min): " + "," + psg_rem_onset_latency_minutes);
  output.println("Number of REM Blocks: " + "," + psg_number_of_rem_blocks);
  output.println();
  output.println("Sleep Fragmentation (Average Number of Minutes Between Stage Transitions): " + "," + psg_average_duration_without_stage_transition_minutes);
  output.println("Sleep Fragmentation (Size of Minimal PSG File)" + "," + psg_sleep_stage_data_array_size);  
  
  output.flush();
  output.close();
      
  file_open_program_flag = false; // reset program flag   
      
  return;
  
} // end of psg_night_summary_function

