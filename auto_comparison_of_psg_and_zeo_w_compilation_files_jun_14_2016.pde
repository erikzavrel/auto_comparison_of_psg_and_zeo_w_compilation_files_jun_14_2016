  } // end else
  
  if (zeo_rem_onset_program_flag == true) { // safety check: REML exists only if REM sleep occurs
    zeo_rem_onset_latency_minutes = zeo_rem_onset_latency_seconds / number_of_seconds_in_a_minute; // convert from seconds to minutes
  } // end if
  
  else {
    zeo_rem_onset_latency_minutes = -1.0; // N/A
  } // end else
    
  zeo_total_minutes_unknown_sleep_stage = zeo_total_seconds_unknown_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  zeo_total_minutes_missing_sleep_stage = zeo_total_seconds_missing_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  zeo_total_minutes_wake_sleep_stage = zeo_total_seconds_wake_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  zeo_total_minutes_rem_sleep_stage = zeo_total_seconds_rem_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  zeo_total_minutes_light_sleep_stage = zeo_total_seconds_light_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
  zeo_total_minutes_deep_sleep_stage = zeo_total_seconds_deep_sleep_stage / number_of_seconds_in_a_minute; // convert from seconds to minutes
    
  zeo_total_sleep_time_minutes = zeo_total_sleep_time_seconds / number_of_seconds_in_a_minute; // convert from seconds to minutes

  if (zeo_sleep_onset_program_flag == true) { // safety check: % exists only if sleep onset occurs
    zeo_rem_sleep_stage_percentage = (zeo_total_minutes_rem_sleep_stage / zeo_total_sleep_time_minutes) * 100; // percentage of sleep that is REM
    zeo_light_sleep_stage_percentage = (zeo_total_minutes_light_sleep_stage / zeo_total_sleep_time_minutes) * 100; // percentage of sleep that is L
    zeo_deep_sleep_stage_percentage = (zeo_total_minutes_deep_sleep_stage / zeo_total_sleep_time_minutes) * 100; // percentage of sleep that is D  
  } // end if
  
  else {
    zeo_rem_sleep_stage_percentage = -1.0; // N/A
    zeo_light_sleep_stage_percentage = -1.0; // N/A
    zeo_deep_sleep_stage_percentage = -1.0; // N/A
  } // end else
   
  zeo_sleep_efficiency_percentage = (zeo_total_sleep_time_minutes / zeo_total_recording_time_minutes) * 100;

  output = createWriter(zeo_night_summary_file_name_1);
  file_open_program_flag = true; // set program flag
   
  output.println("Zeo Night Summary File 1");
  output.println(); // blank line
  output.println("Subject ID Number: " + "," + id_number_of_psg_sleep_stage_file_name);
  output.println(); // blank line
  output.println("Zeo / PSG" + "," + "TRT (min)" + "," + "TST (min)" + "," + "TWT (min)" + "," + "SE (%)" + "," + "Total Unknown (min)" + "," + "Total Missing (min)" + "," + "Total L (min)" + "," + "Total D (min)" + "," + "Total REM (min)" + "," + "% L" + "," + "% D" + "," + "% REM" + "," + "SOL (min)" + "," + "LPS (min)" + "," + "WASO (min)" + "," + "Number of Awakenings" + "," + "REM Onset Latency (min)" + "," + "Number of REM Blocks" + "," + "Sleep Fragmentation (Average Number of Minutes Between Stage Transitions)");
  output.println(); // blank line, last item written to file must be printed using "println" to move to next line
  
  output.println("Zeo" + "," + zeo_total_recording_time_minutes + "," + zeo_total_sleep_time_minutes + "," + zeo_total_minutes_wake_sleep_stage + "," + zeo_sleep_efficiency_percentage + "," + zeo_total_minutes_unknown_sleep_stage + "," + zeo_total_minutes_missing_sleep_stage + "," + zeo_total_minutes_light_sleep_stage + "," + zeo_total_minutes_deep_sleep_stage + "," + zeo_total_minutes_rem_sleep_stage + "," + zeo_light_sleep_stage_percentage + "," + zeo_deep_sleep_stage_percentage + "," + zeo_rem_sleep_stage_percentage + "," + zeo_sleep_onset_latency_minutes + "," + zeo_latency_to_persistent_sleep_minutes + "," + zeo_wakefulness_after_sleep_onset_minutes + "," + zeo_number_of_awakenings + "," + zeo_rem_onset_latency_minutes + "," + zeo_number_of_rem_blocks + "," + zeo_average_duration_without_stage_transition_minutes);
    
