  row_total_stage_by_stage_sum = row_total_stage_by_stage_psg_wake + row_total_stage_by_stage_psg_rem + row_total_stage_by_stage_psg_light + row_total_stage_by_stage_psg_deep;

  column_total_stage_by_stage_zeo_wake = contingency_table_stage_by_stage_zeo_wake_psg_wake_count + contingency_table_stage_by_stage_zeo_wake_psg_rem_count + contingency_table_stage_by_stage_zeo_wake_psg_light_count + contingency_table_stage_by_stage_zeo_wake_psg_deep_count;
  column_total_stage_by_stage_zeo_rem = contingency_table_stage_by_stage_zeo_rem_psg_wake_count + contingency_table_stage_by_stage_zeo_rem_psg_rem_count + contingency_table_stage_by_stage_zeo_rem_psg_light_count + contingency_table_stage_by_stage_zeo_rem_psg_deep_count;
  column_total_stage_by_stage_zeo_light = contingency_table_stage_by_stage_zeo_light_psg_wake_count + contingency_table_stage_by_stage_zeo_light_psg_rem_count + contingency_table_stage_by_stage_zeo_light_psg_light_count + contingency_table_stage_by_stage_zeo_light_psg_deep_count;
  column_total_stage_by_stage_zeo_deep = contingency_table_stage_by_stage_zeo_deep_psg_wake_count + contingency_table_stage_by_stage_zeo_deep_psg_rem_count + contingency_table_stage_by_stage_zeo_deep_psg_light_count + contingency_table_stage_by_stage_zeo_deep_psg_deep_count;

  column_total_stage_by_stage_sum = column_total_stage_by_stage_zeo_wake + column_total_stage_by_stage_zeo_rem + column_total_stage_by_stage_zeo_light + column_total_stage_by_stage_zeo_deep;

  total_number_of_agreements_stage_by_stage = contingency_table_stage_by_stage_zeo_wake_psg_wake_count + contingency_table_stage_by_stage_zeo_rem_psg_rem_count + contingency_table_stage_by_stage_zeo_light_psg_light_count + contingency_table_stage_by_stage_zeo_deep_psg_deep_count;

  overall_total_stage_by_stage = contingency_table_stage_by_stage_zeo_wake_psg_wake_count + contingency_table_stage_by_stage_zeo_wake_psg_rem_count + contingency_table_stage_by_stage_zeo_wake_psg_light_count + contingency_table_stage_by_stage_zeo_wake_psg_deep_count + contingency_table_stage_by_stage_zeo_rem_psg_wake_count + contingency_table_stage_by_stage_zeo_rem_psg_rem_count + contingency_table_stage_by_stage_zeo_rem_psg_light_count + contingency_table_stage_by_stage_zeo_rem_psg_deep_count + contingency_table_stage_by_stage_zeo_light_psg_wake_count + contingency_table_stage_by_stage_zeo_light_psg_rem_count + contingency_table_stage_by_stage_zeo_light_psg_light_count + contingency_table_stage_by_stage_zeo_light_psg_deep_count + contingency_table_stage_by_stage_zeo_deep_psg_wake_count + contingency_table_stage_by_stage_zeo_deep_psg_rem_count + contingency_table_stage_by_stage_zeo_deep_psg_light_count + contingency_table_stage_by_stage_zeo_deep_psg_deep_count; 
    
  expected_frequency_of_agreement_by_chance_stage_by_stage_wake = row_total_stage_by_stage_psg_wake * column_total_stage_by_stage_zeo_wake / overall_total_stage_by_stage;
