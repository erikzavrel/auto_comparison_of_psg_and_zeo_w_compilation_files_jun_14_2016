    for (array_pointer_10 = 0; array_pointer_10 < zeo_rem_epoch_file_array_header_removed_size; array_pointer_10 = array_pointer_10 + 1) {
        
      output.println(zeo_rem_epoch_file_array_header_removed[array_pointer_10]); // cycle through array and write elements back to file
        
    } // end for ... next loop
      
    zeo_number_of_rem_blocks = zeo_number_of_rem_blocks + 1; // another instance of rem or epoch has occurred (distinct and not contiguous events)
    zeo_rem_epoch_duration_minutes = zeo_rem_epoch_duration_seconds / number_of_seconds_in_a_minute; // covert from seconds to minutes
            
