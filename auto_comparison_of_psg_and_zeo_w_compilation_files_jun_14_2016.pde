    zeo_timestamp_month = zeo_month_array_no_gaps[array_pointer_1]; // read from array
    zeo_timestamp_date = zeo_date_array_no_gaps[array_pointer_1]; // read from array
    zeo_timestamp_hour = zeo_hour_array_no_gaps[array_pointer_1]; // read from array
    zeo_timestamp_minute = zeo_minute_array_no_gaps[array_pointer_1]; // read from array
    zeo_timestamp_second = zeo_second_array_no_gaps[array_pointer_1]; // read from array
            
    if (zeo_timestamp_year == specified_zeo_data_range_start_year) { // if years match, proceed
      if (zeo_timestamp_month == specified_zeo_data_range_start_month) { // if months match, proceed
        if (zeo_timestamp_date == specified_zeo_data_range_start_date) { // if dates match, proceed
          if (zeo_timestamp_hour == specified_zeo_data_range_start_hour) { // if hours match, proceed
            if (zeo_timestamp_minute == specified_zeo_data_range_start_minute) { // if minutes match, proceed
              if (zeo_timestamp_second == specified_zeo_data_range_start_second) { // if seconds match, have found start of desired data range
                        
                zeo_data_range_start_element_number = array_pointer_1; // series of nested if's to get number of element that starts desired data range    
                obtained_zeo_data_range_start_element_number_program_flag = true; // set program flag
                        
                } // end if
              } // end if
            } // end if
          } // end if
        } // end if
      } // end if
            
      if (zeo_timestamp_year == specified_zeo_data_range_end_year) { // if years match, proceed
        if (zeo_timestamp_month == specified_zeo_data_range_end_month) { // if months match, proceed
          if (zeo_timestamp_date == specified_zeo_data_range_end_date) { // if dates match, proceed
            if (zeo_timestamp_hour == specified_zeo_data_range_end_hour) { // if hours match, proceed
              if (zeo_timestamp_minute == specified_zeo_data_range_end_minute) { // if minutes match, proceed
                if (zeo_timestamp_second == specified_zeo_data_range_end_second) { // if seconds match, have found end of desired data range
                      
                  zeo_data_range_end_element_number = array_pointer_1; // series of nested if's to get number of element that ends desired data range
                  obtained_zeo_data_range_end_element_number_program_flag = true; // set program flag
                        
                } // end if
              } // end if
            } // end if
          } // end if
        } // end if
      } // end if
            
    } // end for ... next     

  return;
  
} // end of check_data_in_range_function
  
