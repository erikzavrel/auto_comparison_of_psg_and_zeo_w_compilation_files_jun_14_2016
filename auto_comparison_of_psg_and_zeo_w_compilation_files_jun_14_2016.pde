void check_zeo_data_set_for_gaps_function() {
  
  for (array_pointer_5 = 0; array_pointer_5 < zeo_sleep_stage_data_array_header_removed_size; array_pointer_5 = array_pointer_5 + 1) {

    zeo_timestamp_second = zeo_second_array[array_pointer_5]; // read from array
    
    if ((zeo_timestamp_second != 0) && (zeo_timestamp_second != 30)) {
      
      println("Irregular Zeo sleep stage timestamp detected at row number: " + (array_pointer_5 + zeo_file_header_offset + 1)); // row number (element number + header offset + 1 as Excel rows start at 1 while arrays are indexed from 0)
      
      irregular_sleep_stage_timestamp_detected_program_flag = true; // set program flag
      
    } // end if
    
  } // end of for ... next
  
  if (irregular_sleep_stage_timestamp_detected_program_flag == false) { // safety check: only attempt to fill gaps in data if all sleep stage time stamps are standard (second is 0 or 30)
    
    for (array_pointer_5 = 0; array_pointer_5 < zeo_sleep_stage_data_array_header_removed_size; array_pointer_5 = array_pointer_5 + 1) {

      zeo_timestamp_year_value_string = zeo_year_string_array[array_pointer_5]; // read from array
      zeo_timestamp_year = zeo_year_array[array_pointer_5]; // read from array
      zeo_timestamp_month = zeo_month_array[array_pointer_5]; // read from array      
      zeo_timestamp_date = zeo_date_array[array_pointer_5]; // read from array
      zeo_timestamp_hour = zeo_hour_array[array_pointer_5]; // read from array    
      zeo_timestamp_minute = zeo_minute_array[array_pointer_5]; // read from array
      zeo_timestamp_second = zeo_second_array[array_pointer_5]; // read from array
    
      time_total_seconds_zeo = zeo_timestamp_hour * 3600 + zeo_timestamp_minute * 60 + zeo_timestamp_second; // convert time to number of seconds
    
      difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old = abs(time_total_seconds_zeo_old - time_total_seconds_zeo); // get absolute value of difference
       
      if (time_total_seconds_zeo_and_time_total_seconds_zeo_old_comparison_program_flag == false) {
      
        difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old = 30;
        time_total_seconds_zeo_and_time_total_seconds_zeo_old_comparison_program_flag = true; // set program flag
      
      } // end if
    
      if (difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old != 30) { 
      
        if (difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old != 86370) { // rollover at midnight
      
          number_of_gaps = number_of_gaps + 1; // increment
          number_of_stages_in_gap = (difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old / 30) - 1; // may be more than 1 missing stage in data gap (though unlikely)
          number_of_missed_stages = number_of_missed_stages + number_of_stages_in_gap; // increment
        
        } // end if
      
      } // end if

      time_total_seconds_zeo_old = time_total_seconds_zeo; // update
   
    } // end for ... next loop  
    
    gap_location_array = new int [number_of_gaps]; // create array containing element numbers (locations) of gaps
    gap_size_array = new int [number_of_gaps]; // create array containing size of gaps (number of stages in each gap)

    zeo_sleep_stage_data_array_header_removed_size_no_gaps = zeo_sleep_stage_data_array_header_removed_size + number_of_missed_stages; // size for new arrays with no gaps
 
    zeo_year_string_array_no_gaps = new String [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array
    zeo_year_array_no_gaps = new int [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array
    zeo_month_array_no_gaps = new int [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array
    zeo_date_array_no_gaps = new int [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array
    zeo_hour_array_no_gaps = new int [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array
    zeo_minute_array_no_gaps = new int [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array
    zeo_second_array_no_gaps = new int [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array

    zeo_sleep_stage_description_array_no_gaps = new String [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array
    
    zeo_datestamp_array_2 = new String [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array
    zeo_timestamp_array_2 = new String [zeo_sleep_stage_data_array_header_removed_size_no_gaps]; // create array

    number_of_stages_in_gap = 0; // reset
    number_of_missed_stages = 0; // reset
    time_total_seconds_zeo_old = 0; // reset
  
    time_total_seconds_zeo_and_time_total_seconds_zeo_old_comparison_program_flag = false; // reset program flag
  
    for (array_pointer_6 = 0; array_pointer_6 < zeo_sleep_stage_data_array_header_removed_size; array_pointer_6 = array_pointer_6 + 1) {

      zeo_timestamp_year_value_string = zeo_year_string_array[array_pointer_6]; // read from array
      zeo_timestamp_year = zeo_year_array[array_pointer_6]; // read from array
      zeo_timestamp_month = zeo_month_array[array_pointer_6]; // read from array           
      zeo_timestamp_date = zeo_date_array[array_pointer_6]; // read from array
      zeo_timestamp_hour = zeo_hour_array[array_pointer_6]; // read from array     
      zeo_timestamp_minute = zeo_minute_array[array_pointer_6]; // read from array
      zeo_timestamp_second = zeo_second_array[array_pointer_6]; // read from array
    
      time_total_seconds_zeo = zeo_timestamp_hour * 3600 + zeo_timestamp_minute * 60 + zeo_timestamp_second; // convert time to number of seconds
    
      difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old = abs(time_total_seconds_zeo_old - time_total_seconds_zeo); // get absolute value of difference
       
      if (time_total_seconds_zeo_and_time_total_seconds_zeo_old_comparison_program_flag == false) {
      
        difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old = 30;
        time_total_seconds_zeo_and_time_total_seconds_zeo_old_comparison_program_flag = true; // set program flag
      
      } // end if
    
      if (difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old != 30) {
      
        if (difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old != 86370) { // rollover at midnight
    
          number_of_stages_in_gap = (difference_between_time_total_seconds_zeo_and_time_total_seconds_zeo_old / 30) - 1; // may be more than 1 missing stage in data gap (though unlikely)
          number_of_missed_stages = number_of_missed_stages + number_of_stages_in_gap; // increment
        
          gap_location_array[gap_number] = array_pointer_6; // write element number (location) of gap to array
          gap_size_array[gap_number] = number_of_stages_in_gap; // write size of gap (number of stages in gap) to array

          gap_number = gap_number + 1; // increment
      
        } // end if 
      
      } // end if
    
      zeo_year_string_array_no_gaps[array_pointer_6 + number_of_missed_stages] = zeo_year_string_array[array_pointer_6]; // copy from array with gap(s) (incomplete) to array with no gaps (complete)
      zeo_year_array_no_gaps[array_pointer_6 + number_of_missed_stages] = zeo_year_array[array_pointer_6]; // copy from array with gap(s) (incomplete) to array with no gaps (complete)
      zeo_month_array_no_gaps[array_pointer_6 + number_of_missed_stages] = zeo_month_array[array_pointer_6]; // copy from array with gap(s) (incomplete) to array with no gaps (complete)
      zeo_date_array_no_gaps[array_pointer_6 + number_of_missed_stages] = zeo_date_array[array_pointer_6]; // copy from array with gap(s) (incomplete) to array with no gaps (complete)
      zeo_hour_array_no_gaps[array_pointer_6 + number_of_missed_stages] = zeo_hour_array[array_pointer_6]; // copy from array with gap(s) (incomplete) to array with no gaps (complete)
      zeo_minute_array_no_gaps[array_pointer_6 + number_of_missed_stages] = zeo_minute_array[array_pointer_6]; // copy from array with gap(s) (incomplete) to array with no gaps (complete)
      zeo_second_array_no_gaps[array_pointer_6 + number_of_missed_stages] = zeo_second_array[array_pointer_6]; // copy from array with gap(s) (incomplete) to array with no gaps (complete)

      zeo_sleep_stage_description_array_no_gaps[array_pointer_6 + number_of_missed_stages] = zeo_sleep_stage_description_array[array_pointer_6]; // copy from array with gap(s) (incomplete) to array with no gaps (complete)
       
      time_total_seconds_zeo_old = time_total_seconds_zeo; // update
   
    } // end for ... next loop  

    number_of_missed_stages = 0; // reset 

    for (gap_counter = 0; gap_counter < number_of_gaps; gap_counter = gap_counter + 1) {
  
      gap_location = gap_location_array[gap_counter]; // read from array
      number_of_stages_in_gap = gap_size_array[gap_counter]; // read from array

      zeo_timestamp_year_value_string = zeo_year_string_array[gap_location - 1]; // must use index of (location of gap - 1) to get time to increment as gap may consist of more than 1 stage
      zeo_timestamp_year = zeo_year_array[gap_location - 1]; // must use index of (location of gap - 1) to get time to increment as gap may consist of more than 1 stage
      zeo_timestamp_month = zeo_month_array[gap_location - 1]; // must use index of (location of gap - 1) to get time to increment as gap may consist of more than 1 stage
