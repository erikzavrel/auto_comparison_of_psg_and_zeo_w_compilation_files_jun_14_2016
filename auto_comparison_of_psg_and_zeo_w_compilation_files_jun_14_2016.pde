    output.close();
      
    file_open_program_flag = false; // reset program flag 
 
    zeo_rem_epoch_duration_seconds = 0; // rem epoch has ended, log it and reset the epoch duration counter to 0     
  
  } // end if    
    
  if (zeo_recording_end_date == zeo_recording_start_date) { 
