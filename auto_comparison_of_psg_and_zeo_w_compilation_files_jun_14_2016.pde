        zeo_sleep_onset_date = zeo_timestamp_date;
        
        zeo_sleep_onset_program_flag = true; // set the flag so that this code block does not execute again
        
      } // end if
      
      zeo_seconds_of_continuous_sleep = zeo_seconds_of_continuous_sleep + 30; // increment counter
      
    } // end if
    
    else {
      
      zeo_seconds_of_continuous_sleep = 0; // reset counter
      
    } // end else
    
    zeo_minutes_of_continuous_sleep = zeo_seconds_of_continuous_sleep / number_of_seconds_in_a_minute; // covert from seconds to minutes

    if (zeo_persistent_sleep_onset_program_flag == false) {
    
