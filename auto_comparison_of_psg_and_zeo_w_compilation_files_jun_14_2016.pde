void interpolation_function_2() {
  
  psg_stage_data_stage_description_length = psg_stage_data_stage_description.length(); // get length of stage description
  
  switch (psg_stage_data_stage_description_length) {
    
    case 9: 
      psg_stage_data_stage_description_processed_array[0] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 1);
      break; // break out of selection process otherwise command under next case will execute
      // 9 characters corresponds to L or R ("Stage - L" or "Stage - R")
    case 10:
      psg_stage_data_stage_description_processed_array[0] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 2);
      psg_stage_data_stage_description_processed_array[1] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 1);
      break; // break out of selection process otherwise command under next case will execute
      // 10 characters corresponds to N1 or N2 or N3 ("Stage - N1" or "Stage - N2" or "Stage - N3")
    case 16:
      psg_stage_data_stage_description_processed_array[0] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 8);
      psg_stage_data_stage_description_processed_array[1] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 7);    
      psg_stage_data_stage_description_processed_array[2] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 6);
      psg_stage_data_stage_description_processed_array[3] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 5);
      psg_stage_data_stage_description_processed_array[4] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 4);
      psg_stage_data_stage_description_processed_array[5] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 3);
      psg_stage_data_stage_description_processed_array[6] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 2);
      psg_stage_data_stage_description_processed_array[7] = psg_stage_data_stage_description.charAt(psg_stage_data_stage_description_length - 1);
     break; // break out of selection process otherwise command under next case will execute
     // 16 characters corresponds to No Stage ("Stage - No Stage")
     
  } // end of switch ... case statement
  
  psg_stage_data_stage_description_processed = new String(psg_stage_data_stage_description_processed_array); // create string from contents of char array
  
  if (psg_stage_data_stage_description_processed.equals(psg_wake_sleep_stage_description) == true) {
    psg_stage_data_stage_description_processed = psg_wake_sleep_stage_description_final;
  } // end if 
  
  else if (psg_stage_data_stage_description_processed.equals(psg_rem_sleep_stage_description) == true) {
    psg_stage_data_stage_description_processed = psg_rem_sleep_stage_description_final;
  } // end else if     

  else if (psg_stage_data_stage_description_processed.equals(psg_N1_sleep_stage_description) == true) {
    psg_stage_data_stage_description_processed = psg_N1_sleep_stage_description_final;
  } // end else if 
  
  else if (psg_stage_data_stage_description_processed.equals(psg_N2_sleep_stage_description) == true) {
    psg_stage_data_stage_description_processed = psg_N2_sleep_stage_description_final;
  } // end else if       
  
  else if (psg_stage_data_stage_description_processed.equals(psg_N3_sleep_stage_description) == true) {
    psg_stage_data_stage_description_processed = psg_N3_sleep_stage_description_final;
  } // end else if 
  
  psg_timestamp_hour_tens_place_char = psg_timestamp_string.charAt(1); // get character at specific index
  psg_timestamp_hour_ones_place_char = psg_timestamp_string.charAt(2); // get character at specific index
    
  psg_timestamp_minute_tens_place_char = psg_timestamp_string.charAt(4); // get character at specific index
  psg_timestamp_minute_ones_place_char = psg_timestamp_string.charAt(5); // get character at specific index
    
  psg_timestamp_second_tens_place_char = psg_timestamp_string.charAt(7); // get character at specific index
  psg_timestamp_second_ones_place_char = psg_timestamp_string.charAt(8); // get character at specific index,

  psg_timestamp_hour_tens_place_int = int(psg_timestamp_hour_tens_place_char - ascii_offset); // cast as integer and remove ASCII offset (SPACE at 0 index of string)
  psg_timestamp_hour_ones_place_int = int(psg_timestamp_hour_ones_place_char - ascii_offset); // cast as integer and remove ASCII offset (SPACE at 0 index of string)
    
  psg_timestamp_minute_tens_place_int = int(psg_timestamp_minute_tens_place_char - ascii_offset); // cast as integer and remove ASCII offset (SPACE at 0 index of string)
  psg_timestamp_minute_ones_place_int = int(psg_timestamp_minute_ones_place_char - ascii_offset); // cast as integer and remove ASCII offset (SPACE at 0 index of string)
    
  psg_timestamp_second_tens_place_int = int(psg_timestamp_second_tens_place_char - ascii_offset); // cast as integer and remove ASCII offset (SPACE at 0 index of string)
  psg_timestamp_second_ones_place_int = int(psg_timestamp_second_ones_place_char - ascii_offset); // cast as integer and remove ASCII offset (SPACE at 0 index of string)
        
  psg_timestamp_hour = 10 * psg_timestamp_hour_tens_place_int + psg_timestamp_hour_ones_place_int; // reconstruct value
  psg_timestamp_minute = 10 * psg_timestamp_minute_tens_place_int + psg_timestamp_minute_ones_place_int; // reconstruct value
  psg_timestamp_second = 10 * psg_timestamp_second_tens_place_int + psg_timestamp_second_ones_place_int; // reconstruct value
        
  time_total_seconds_psg = psg_timestamp_hour * 3600 + psg_timestamp_minute * 60 + psg_timestamp_second; // convert time to number of seconds
      
  time_total_seconds_psg_incremented = time_total_seconds_psg + second_incrementer * 30; // increment number of seconds to update time stamp
    
  epoch_counter = epoch_counter + 1; // increment counter here so first epoch appears as 1 not 0
  second_incrementer = second_incrementer + 1; // increment second counter here so first time stamp is not 30 s off (0 * 30 = 0)

  psg_timestamp_hour = time_total_seconds_psg_incremented / 3600; // get hour
  psg_timestamp_minute = (time_total_seconds_psg_incremented % 3600) / 60; // get minute 
  psg_timestamp_second = (time_total_seconds_psg_incremented % 3600) % 60; // get second
  
  if (psg_timestamp_hour >= 24) {
    psg_timestamp_hour = psg_timestamp_hour - 24;
  } // safety check
    
  psg_timestamp_hour_string = nf(psg_timestamp_hour, 2); // format as string with 2 characters
  psg_timestamp_minute_string = nf(psg_timestamp_minute, 2); // format as string with 2 characters
  psg_timestamp_second_string = nf(psg_timestamp_second, 2); // format as string with 2 characters
    
  psg_timestamp_array[0] = psg_timestamp_hour_string.charAt(0); // write to appropriate element location of array: HH:MM:SS
  psg_timestamp_array[1] = psg_timestamp_hour_string.charAt(1); // write to appropriate element location of array: HH:MM:SS
    
  psg_timestamp_array[3] = psg_timestamp_minute_string.charAt(0); // write to appropriate element location of array: HH:MM:SS
  psg_timestamp_array[4] = psg_timestamp_minute_string.charAt(1); // write to appropriate element location of array: HH:MM:SS

  psg_timestamp_array[6] = psg_timestamp_second_string.charAt(0); // write to appropriate element location of array: HH:MM:SS
  psg_timestamp_array[7] = psg_timestamp_second_string.charAt(1); // write to appropriate element location of array: HH:MM:SS
    
  psg_timestamp = new String(psg_timestamp_array); // create string from contents of char array
    
  interpolated_psg_stage_data_epoch_number_array[array_pointer_4] = epoch_counter;
  interpolated_psg_stage_data_timestamp_array[array_pointer_4] = psg_timestamp; // write to array
  interpolated_psg_stage_data_stage_description_array[array_pointer_4] = psg_stage_data_stage_description_processed;
       
  output.println(epoch_counter + "," + psg_timestamp + "," + psg_stage_data_stage_description_processed); // write to file, need to use println to move to next line
  
  return;
  
} // end of interpolation_function_2
  
