  zeo_sleep_stage_data_array = loadStrings(zeo_sleep_stage_file_name); // create and assign - file being read from must be placed within the data file of the processing sketch directory 
  psg_sleep_stage_data_array = loadStrings(psg_sleep_stage_file_name); // create and assign - file being read from must be placed within the data file of the processing sketch directory 

  zeo_sleep_stage_data_array_size = zeo_sleep_stage_data_array.length; // get the raw size of the sleep stage data file including header offset
  zeo_sleep_stage_data_array_header_removed_size = zeo_sleep_stage_data_array_size - zeo_file_header_offset; // subtract header offset to get processed size of sleep stage data file array (number of data items = array size + 1 as array index starts at zero!)
  zeo_sleep_stage_data_array_header_removed = new String [zeo_sleep_stage_data_array_header_removed_size]; // create - subset of sleep stage data file array with header removed (only data)
  arrayCopy(zeo_sleep_stage_data_array, zeo_file_header_offset, zeo_sleep_stage_data_array_header_removed, 0, zeo_sleep_stage_data_array_header_removed_size); // assign - copy only data items to new array (omit header)

  // source array, starting location of source array, destination array, starting location of destination array, number of items to copy 
 
  zeo_year_string_array = new String [zeo_sleep_stage_data_array_header_removed_size]; // create array
  zeo_year_array = new int [zeo_sleep_stage_data_array_header_removed_size]; // create array
  zeo_month_array = new int [zeo_sleep_stage_data_array_header_removed_size]; // create array
  zeo_date_array = new int [zeo_sleep_stage_data_array_header_removed_size]; // create array
  zeo_hour_array = new int [zeo_sleep_stage_data_array_header_removed_size]; // create array
  zeo_minute_array = new int [zeo_sleep_stage_data_array_header_removed_size]; // create array
  zeo_second_array = new int [zeo_sleep_stage_data_array_header_removed_size]; // create array

  zeo_sleep_stage_description_array = new String [zeo_sleep_stage_data_array_header_removed_size]; // declare array

  for (array_pointer_0 = 0; array_pointer_0 < zeo_sleep_stage_data_array_header_removed_size; array_pointer_0 = array_pointer_0 + 1) {

    single_line_from_zeo_sleep_stage_data_array = zeo_sleep_stage_data_array_header_removed[array_pointer_0]; // line 5 is first row with dataso element 5 of string array becomes data to parse
    parsed_items_0 = split(single_line_from_zeo_sleep_stage_data_array, ","); // create and assign - parse the line, comma delimited values
   
    zeo_timestamp_year_value_string = parsed_items_0[0]; // assign
    zeo_year_string_array[array_pointer_0] = zeo_timestamp_year_value_string; // write value to array
    zeo_timestamp_year_tens_place = int(zeo_timestamp_year_value_string.charAt(2)) - ascii_offset; // get character at specific index, cast as integer, and remove ASCII offset (SPACE at 0 index of string)
    zeo_timestamp_year_ones_place = int(zeo_timestamp_year_value_string.charAt(3)) - ascii_offset; // get character at specific index, cast as integer, and remove ASCII offset (SPACE at 0 index of string)
    zeo_timestamp_year = 10 * zeo_timestamp_year_tens_place + zeo_timestamp_year_ones_place; // reconstruct value
    zeo_year_array[array_pointer_0] = zeo_timestamp_year; // write value to array

    zeo_timestamp_month = int(parsed_items_0[1]); // assign
    zeo_month_array[array_pointer_0] = zeo_timestamp_month; // write value to array
 
    zeo_timestamp_date = int(parsed_items_0[2]); // assign
    zeo_date_array[array_pointer_0] = zeo_timestamp_date; // write value to array

    zeo_timestamp_hour = int(parsed_items_0[3]); // assign
    zeo_hour_array[array_pointer_0] = zeo_timestamp_hour; // write value to array
          
    zeo_timestamp_minute = int(parsed_items_0[4]); // assign
    zeo_minute_array[array_pointer_0] = zeo_timestamp_minute; // write value to array

    zeo_timestamp_second = int(parsed_items_0[5]); // assign           
    zeo_second_array[array_pointer_0] = zeo_timestamp_second; // write value to array
    
    zeo_sleep_stage_description = parsed_items_0[8]; // assign
    zeo_sleep_stage_description_array[array_pointer_0] = zeo_sleep_stage_description; // write value to array, parsed sleep stage description already a string so don't need to convert data type
   
  } // end for ... next loop
  
  psg_sleep_stage_data_array_size = psg_sleep_stage_data_array.length; // get the raw size of the sleep stage data file including header offset
  psg_sleep_stage_data_array_header_removed_size = psg_sleep_stage_data_array_size - psg_file_header_offset; // subtract header offset to get processed size of sleep stage data file array (number of data items = array size + 1 as array index starts at zero!)
  psg_sleep_stage_data_array_header_removed = new String [psg_sleep_stage_data_array_header_removed_size]; // create - subset of sleep stage data file array with header removed (only data)
  arrayCopy(psg_sleep_stage_data_array, psg_file_header_offset, psg_sleep_stage_data_array_header_removed, 0, psg_sleep_stage_data_array_header_removed_size); // assign - copy only data items to new array (omit header)  

  // source array, starting location of source array, destination array, starting location of destination array, number of items to copy 

  return;
  
} // end of load_files_function

