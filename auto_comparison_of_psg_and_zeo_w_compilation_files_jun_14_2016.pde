void compare_data_sets_function() {  
  
  write_psg_epoch_timestamps_to_array_function(); // call function
  write_zeo_epoch_timestamps_to_array_function(); // call function
  
  zeo_start_seconds = specified_zeo_data_range_start_hour * 3600 + specified_zeo_data_range_start_minute * 60 + specified_zeo_data_range_start_second;
  zeo_end_seconds = specified_zeo_data_range_end_hour * 3600 + specified_zeo_data_range_end_minute * 60 + specified_zeo_data_range_end_second;
  
  for (array_pointer_8 = 0; array_pointer_8 < psg_stage_data_interpolated_array_size; array_pointer_8 = array_pointer_8 + 1) {
      
    psg_timestamp_hour = interpolated_psg_stage_data_timestamp_hour_array[array_pointer_8];
    psg_timestamp_minute = interpolated_psg_stage_data_timestamp_minute_array[array_pointer_8];
    psg_timestamp_second = interpolated_psg_stage_data_timestamp_second_array[array_pointer_8];
    
    time_total_seconds_psg = psg_timestamp_hour * 3600 + psg_timestamp_minute * 60 + psg_timestamp_second; // convert time to number of seconds  
  
    difference_between_zeo_start_and_psg_total_seconds = zeo_start_seconds - time_total_seconds_psg; // find difference between zeo time and psg time (in seconds)
    difference_between_zeo_end_and_psg_total_seconds = zeo_end_seconds - time_total_seconds_psg; // find difference between zeo time and psg time (in seconds)
    
    absolute_value_of_difference_between_zeo_start_and_psg_total_seconds = abs(difference_between_zeo_start_and_psg_total_seconds); // get absolute value of difference between zeo time and psg time (in seconds)
    absolute_value_of_difference_between_zeo_end_and_psg_total_seconds = abs(difference_between_zeo_end_and_psg_total_seconds); // get absolute value of difference between zeo time and psg time (in seconds)
  
    if ((absolute_value_of_difference_between_zeo_start_and_psg_total_seconds_minimized_program_flag == false) && (absolute_value_of_difference_between_zeo_end_and_psg_total_seconds_minimized_program_flag == false)) {
      
      minimum_of_absolute_value_of_difference_between_zeo_start_and_psg_total_seconds = absolute_value_of_difference_between_zeo_start_and_psg_total_seconds; // must set otherwise won't get overwritten as initialized to zero
      minimum_of_absolute_value_of_difference_between_zeo_end_and_psg_total_seconds = absolute_value_of_difference_between_zeo_end_and_psg_total_seconds; // must set otherwise won't get overwritten as initialized to zero
      
      absolute_value_of_difference_between_zeo_start_and_psg_total_seconds_minimized_program_flag = true; // set program flag 
      absolute_value_of_difference_between_zeo_end_and_psg_total_seconds_minimized_program_flag = true; // set program flag 
      
    } // end if
    
    if (absolute_value_of_difference_between_zeo_start_and_psg_total_seconds < minimum_of_absolute_value_of_difference_between_zeo_start_and_psg_total_seconds) {
     
      minimum_of_absolute_value_of_difference_between_zeo_start_and_psg_total_seconds = absolute_value_of_difference_between_zeo_start_and_psg_total_seconds; // update
      psg_epoch_number_start_ref_array_element_number = array_pointer_8;
    
    } // end if
    
    if (absolute_value_of_difference_between_zeo_end_and_psg_total_seconds < minimum_of_absolute_value_of_difference_between_zeo_end_and_psg_total_seconds) {
     
      minimum_of_absolute_value_of_difference_between_zeo_end_and_psg_total_seconds = absolute_value_of_difference_between_zeo_end_and_psg_total_seconds; // update
      psg_epoch_number_end_ref_array_element_number = array_pointer_8;
    
    } // end if    
    
  } // end of for ... next
  
  if ((minimum_of_absolute_value_of_difference_between_zeo_start_and_psg_total_seconds > 15) || (minimum_of_absolute_value_of_difference_between_zeo_end_and_psg_total_seconds > 15)) {
    
    program_state = data_out_of_range_error_message_program_state; // update program state to move on
    
  } // end if
     
  else {
        
    if (difference_between_zeo_start_and_psg_total_seconds < 0) {
      lead_or_lag_string = "Zeo leads PSG"; // zeo sec - psg sec is negative meaning zeo epoch comes first and is smaller
    } // end if
  
    else if (difference_between_zeo_start_and_psg_total_seconds > 0) {
      lead_or_lag_string = "Zeo lags PSG"; // zeo sec - psg sec is positive meaning zeo epoch comes after and is larger than psg 
    } // end if
    
    else {
      lead_or_lag_string = "Zeo and PSG are synchronized"; // zeo sec - psg sec = 0 
    } // end if       
    
    stage_by_stage_match_array = new String [zeo_data_range_end_element_number - zeo_data_range_start_element_number + 1]; // create array of appropriate size
    wake_rem_nrem_match_array = new String [zeo_data_range_end_element_number - zeo_data_range_start_element_number + 1]; // create array of appropriate size
    wake_sleep_match_array = new String [zeo_data_range_end_element_number - zeo_data_range_start_element_number + 1]; // create array of appropriate size
       
    comparison_stage_by_stage_function(); // call function
    comparison_stage_by_stage_for_spss_function(); // call function

    comparison_wake_rem_nrem_function(); // call function
    comparison_wake_rem_nrem_for_spss_function(); // call function
        
    comparison_wake_sleep_function(); // call function
    comparison_wake_sleep_for_spss_function(); // call function

    comparison_composite_function(); // call function
    statistical_analysis_function(); // call function
    comparison_final_function(); // call function
    
    zeo_night_summary_function(); // call function
    psg_night_summary_function(); // call function
    composite_night_summary_function(); // call function
    
    rem_analysis_function(); // call function
        
    awakening_analysis_function(); // call function
    
    append_to_compilation_files_function(); // call function
  
    program_state = final_program_state; // update program state to move on

  } // end else

  return;
  
} // end of compare_data_sets_function
  
