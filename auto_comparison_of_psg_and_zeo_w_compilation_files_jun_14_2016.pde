    zeo_rem_epoch_file_array_header_removed = new String [zeo_rem_epoch_file_array_header_removed_size]; // create - subset of file array with header removed (only data)
    arrayCopy(zeo_rem_epoch_file_array, file_header_offset, zeo_rem_epoch_file_array_header_removed, 0, zeo_rem_epoch_file_array_header_removed_size); // assign - copy only data items to new array (omit header)      

    output = createWriter(zeo_rem_file_name);
    file_open_program_flag = true; // set program flag
   
