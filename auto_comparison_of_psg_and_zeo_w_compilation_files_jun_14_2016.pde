void setup () {
  
  size(screen.width, screen.height); // make window the same size as screen size - optimizes, makes window as large as possible, use present not run to fill screen
  frameRate(60); // set frame rate high for faster refresh rate - make graphics smoother, PC screen refresh rate is 60 Hz
  background(0); // black background
 
  fontA = loadFont("ArialRoundedMTBold-48.vlw"); // load font - do not load in draw function as will slow program exection
  fontB = loadFont("Calibri-Bold-48.vlw"); // load font - do not load in draw function as will slow program exection
  fontC = loadFont("TimesNewRomanPSMT-12.vlw"); // load font - do not load in draw function as will slow program exection
 
  zeo_logo = loadImage("zeo_logo.jpg"); // load logo - do not load in draw function as will slow program exection

} // end of setup

// *****************************************************************************************************************************************************************************************

void draw() {
  
  if (program_state != load_logo_upon_startup_program_state) { // if ibutton logo has already been displayed
     prepare_standard_screen_function(); // things that are displayed in every frame: title, date, time
  } // end if
      
  switch (program_state) {
    
    case load_logo_upon_startup_program_state: // where program starts
     
      background(255); // white background
      imageMode(CENTER); // align logo with center of screen
      image(zeo_logo,  screen.width / 2, screen.height / 2); // display image, will be rendered when end of draw function is reached
      
      program_state = pause_to_display_logo_upon_startup_program_state; // update program state to move on
      
      delay_duration = 0; // no delay desired
      
      break; // break out of selection process otherwise command under next case will execute
      
    case pause_to_display_logo_upon_startup_program_state:
    
      program_state = prompt_user_to_continue_or_exit_program_state; // update program state to move on
      
      delay_duration = 3000; // keep logo (previously rendered) displayed for 3 sec, make program hang for 3 sec

      break; // break out of selection process otherwise command under next case will execute
    
    case prompt_user_to_continue_or_exit_program_state: // where program starts
      
      textFont(fontA); // set font
      textSize(font_size_user_prompt); // set font size
      textAlign(CENTER, CENTER); // set font alignment
      
      text("Reminder: Zeo and PSG data files must be placed in program's data folder.", screen.width / 2, screen.height / 2);
      text("Press ENTER to proceed or ESC to exit program.", screen.width / 2, screen.height / 2 + user_input_prompts_y_offset);
      
      delay_duration = 0; // no delay desired

      break; // break out of selection process otherwise command under next case will execute
      
    case prompt_user_for_month_of_zeo_sleep_stage_file_name_program_state:
    
      textFont(fontA); // set font
      textSize(font_size_user_prompt); // set font size
      textAlign(CENTER, CENTER); // set font alignment
      
      text("Enter the month in the name of the Zeo sleep stage file to be loaded.", screen.width / 2, screen.height / 2);
      text("Use two digit format (MM), e.g., 01 for January:", screen.width / 2, screen.height / 2 + user_input_prompts_y_offset);
      
      delay_duration = 0; // no delay desired
      
      break; // break out of selection process otherwise command under next case will execute 

    case confirm_month_of_zeo_sleep_stage_file_name_program_state:
  
      textFont(fontA); // set font
      textSize(font_size_user_prompt_confirmation_small); // set font size
      textAlign(CENTER, CENTER); // set font alignment
      text("Is ", screen.width / 2, screen.height / 2 - user_input_prompts_y_offset);

      textSize(font_size_user_prompt_confirmation_large);      
      fill(font_color_red_rgb_red_value, font_color_red_rgb_green_value, font_color_red_rgb_blue_value); // text font color set to red
      text(zeo_sleep_stage_file_name_month, screen.width / 2, screen.height / 2);
      
      textSize(font_size_user_prompt_confirmation_small);
      fill(font_color_white_rgb_red_value, font_color_white_rgb_green_value, font_color_white_rgb_blue_value); // text font color set to white
      text("the correct month? (Y/N)", screen.width / 2, screen.height / 2 + user_input_prompts_y_offset);
      
      delay_duration = 0; // no delay desired
      
      break; // break out of selection process otherwise command under next case will execute    
      
    case prompt_user_for_date_of_zeo_sleep_stage_file_name_program_state:
    
      textFont(fontA); // set font
      textSize(font_size_user_prompt); // set font size
      textAlign(CENTER, CENTER); // set font alignment
      
      text("Enter the date in the name of the Zeo sleep stage file to be loaded.", screen.width / 2, screen.height / 2);
      text("Use two digit format (DD), e.g., 01 for the 1st:", screen.width / 2, screen.height / 2 + user_input_prompts_y_offset);
            
      delay_duration = 0; // no delay desired
      
      break; // break out of selection process otherwise command under next case will execute 

    case confirm_date_of_zeo_sleep_stage_file_name_program_state:
  
      textFont(fontA); // set font
      textSize(font_size_user_prompt_confirmation_small); // set font size
      textAlign(CENTER, CENTER); // set font alignment
      text("Is ", screen.width / 2, screen.height / 2 - user_input_prompts_y_offset);
      
      textSize(font_size_user_prompt_confirmation_large);
      fill(font_color_red_rgb_red_value, font_color_red_rgb_green_value, font_color_red_rgb_blue_value); // text font color set to red
      text(zeo_sleep_stage_file_name_date, screen.width / 2, screen.height / 2);

      textSize(font_size_user_prompt_confirmation_small);      
      fill(font_color_white_rgb_red_value, font_color_white_rgb_green_value, font_color_white_rgb_blue_value); // text font color set to white
      text("the correct date? (Y/N)", screen.width / 2, screen.height / 2 + user_input_prompts_y_offset);
      
      delay_duration = 0; // no delay desired
      
      break; // break out of selection process otherwise command under next case will execute 
      
    case prompt_user_for_id_number_of_psg_sleep_stage_file_name_program_state:
        
      textFont(fontA); // set font
      textSize(font_size_user_prompt); // set font size
      textAlign(CENTER, CENTER); // set font alignment
      
