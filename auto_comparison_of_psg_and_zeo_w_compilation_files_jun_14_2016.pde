        zeo_timestamp_minute = (time_total_seconds_zeo_incremented % 3600) / 60; // convert time in seconds to time in hours, minutes, seconds  
        zeo_timestamp_second = (time_total_seconds_zeo_incremented % 3600) % 60; // convert time in seconds to time in hours, minutes, seconds  

        zeo_year_string_array_no_gaps[gap_location + number_of_missed_stages] = zeo_timestamp_year_value_string; // write to array
  
