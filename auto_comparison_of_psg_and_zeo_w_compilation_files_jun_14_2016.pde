int calculate_timestamp_seconds(int timestamp_hour, int timestamp_minute, int timestamp_second) {
  
  int timestamp_seconds = timestamp_hour * 3600 + timestamp_minute * 60 + timestamp_second; // convert time to number of seconds
  
  return(timestamp_seconds);
  
} // end of calculate_timestamp_seconds function

