void check_data_in_range_function() {
  
  for (array_pointer_1 = 0; array_pointer_1 < zeo_sleep_stage_data_array_header_removed_size_no_gaps; array_pointer_1 = array_pointer_1 + 1) { // iterate through line by line, minus 1 because last line in ibutton data file is "end"
            
