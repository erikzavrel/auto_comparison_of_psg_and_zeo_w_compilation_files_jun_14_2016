  } // end else
      
  if (zeo_sleep_onset_date == zeo_recording_start_date) {
    zeo_sleep_onset_latency_seconds = zeo_sleep_onset_time_seconds - zeo_recording_time_start_seconds; // time from recording start to sleep onset if recording starts and sleep onset occurs on same date
