void prepare_standard_screen_function() {
  
  background(0); // clears screen - essential for proper display, black background
  fill(font_color_white_rgb_red_value, font_color_white_rgb_green_value, font_color_white_rgb_blue_value); // text font color set to white
  
  textFont(fontA); // set font
  textSize(font_size_program_title); // set font size
  textAlign(CENTER, TOP); // set font alignment
    
  text("Zeo vs. PSG Comparison Program", screen.width / 2, 0);
      
  current_year = year(); // current year
  current_month = month(); // current month
  current_day = day(); // current day
  current_hour = hour(); // current hour
  current_minute = minute(); // current minute
  current_second = second(); // current second
   
  switch (current_month) {
    case 1: 
      month_name = "JAN";
      break; // break out of selection process otherwise command under next case will execute
    case 2: 
      month_name = "FEB";
      break; // break out of selection process otherwise command under next case will execute
    case 3: 
      month_name = "MAR";
      break; // break out of selection process otherwise command under next case will execute
    case 4: 
      month_name = "APR";
      break; // break out of selection process otherwise command under next case will execute
    case 5: 
      month_name = "MAY";
      break; // break out of selection process otherwise command under next case will execute
    case 6: 
      month_name = "JUN";
      break; // break out of selection process otherwise command under next case will execute
    case 7: 
      month_name = "JUL";
      break; // break out of selection process otherwise command under next case will execute
    case 8: 
      month_name = "AUG";
      break; // break out of selection process otherwise command under next case will execute
    case 9: 
      month_name = "SEP";
      break; // break out of selection process otherwise command under next case will execute
    case 10: 
      month_name = "OCT";
      break; // break out of selection process otherwise command under next case will execute
    case 11: 
      month_name = "NOV";
      break; // break out of selection process otherwise command under next case will execute
    case 12: 
      month_name = "DEC";
      break; // break out of selection process otherwise command under next case will execute
  } // end of switch statement to determine month name
  
  current_year_string = nf(current_year, 4); // cast as string
  current_day_string = nf(current_day, 2);  // cast as string
  current_hour_string = nf(current_hour, 2); // cast as string
