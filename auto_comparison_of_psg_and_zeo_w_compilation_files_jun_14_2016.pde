  } // end of for ... next
  
  if ((zeo_sleep_stage_description_old.equals(zeo_wake_sleep_stage_description) == false) && (zeo_sleep_stage_description_old.equals(zeo_unknown_sleep_stage_description) == false) && (zeo_sleep_stage_description_old.equals(zeo_missing_sleep_stage_description) == false)) {
       
    zeo_total_duration_without_stage_transition_seconds = zeo_total_duration_without_stage_transition_seconds + zeo_duration_without_stage_transition_seconds;
    zeo_blocks_without_stage_transition_counter = zeo_blocks_without_stage_transition_counter + 1;
    
  } // only count last continuous block if not unknown, missing, or awake (want measure of sleep fragmentation)

  zeo_average_duration_without_stage_transition_seconds = zeo_total_duration_without_stage_transition_seconds / float(zeo_blocks_without_stage_transition_counter);
  zeo_average_duration_without_stage_transition_minutes = zeo_average_duration_without_stage_transition_seconds / number_of_seconds_in_a_minute; // measure of sleep fragmentation
   
  if (zeo_rem_epoch_duration_seconds != 0) { // check to see if ending comparison in middle of a REM epoch
    
